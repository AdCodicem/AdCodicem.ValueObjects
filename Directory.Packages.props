<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Build">
    <PackageVersion Include="MinVer" Version="6.1.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
  </ItemGroup>

  <ItemGroup Label="Source generators and analyzers">
    <!-- The Roslyn API the generator is built against, which sets the oldest compiler a consumer may use, and which the
         generator tests compile snippets with. The unit suite takes 5.0.0: it compiles NSwag's client with Roslyn,
         and it reaches Orleans, whose Microsoft.Orleans.Serialization brings Microsoft.CodeAnalysis.Common 5.0.0, which
         CSharp 4.14.0 refuses (NU1608, an error here). So does the Wolverine.Http fixture application, whose
         WolverineFx.RuntimeCompilation compiles the endpoints' generated code through JasperFx.RuntimeCompiler 5.0.0,
         which asks for Microsoft.CodeAnalysis 5.0.0, CSharp 5.0.0 and, through the first, CSharp.Workspaces 5.0.0
         exactly (NU1109 otherwise). Conditioned on the project rather than set by a VersionOverride, so that every
         version stays in this file. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" Condition="'$(MSBuildProjectName)' != 'AdCodicem.ValueObjects.UnitTests' and '$(MSBuildProjectName)' != 'AdCodicem.ValueObjects.Fixtures.WolverineHttp'" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" Condition="'$(MSBuildProjectName)' == 'AdCodicem.ValueObjects.UnitTests' or '$(MSBuildProjectName)' == 'AdCodicem.ValueObjects.Fixtures.WolverineHttp'" />
    <!-- The code fix, in an assembly of its own: RS1038 refuses Workspaces where an analyzer or a generator lives. The
         Wolverine.Http fixture application takes 5.0.0, as above. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" Condition="'$(MSBuildProjectName)' != 'AdCodicem.ValueObjects.Fixtures.WolverineHttp'" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" Condition="'$(MSBuildProjectName)' == 'AdCodicem.ValueObjects.Fixtures.WolverineHttp'" />
    <!-- The analyzers that check the generator's and the code fix's own code, whose Roslyn API is the CSharp pin above. At
         the floor Microsoft.Orleans.Serialization 10.4.0 declares, below which every project reaching Orleans fails to
         restore (NU1109); transitive pinning lists it as a dependency of the Orleans package. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="PolySharp" Version="1.16.0" />
  </ItemGroup>

  <ItemGroup Label="Integrations">
    <!-- Pinned explicitly: 2.0.0, which older ASP.NET Core patches resolve to, carries a known advisory. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <!-- No project references these two: they are transitive pins. They raise the 6.0.0 that BenchmarkDotNet's
         Microsoft.Extensions.Logging asks for in the benchmarks to the version Entity Framework Core asks for,
         and pinning lists them as dependencies of both Entity Framework Core packages, of the MessagePack
         package, which reaches them through the hub protocol's Microsoft.AspNetCore.SignalR.Common, of the Model
         Context Protocol package, which reaches them through Microsoft.Extensions.Hosting.Abstractions, of the Azure
         Functions package, which reaches them through Worker.Core, of both HotChocolate packages, which reach them
         through HotChocolate.Types, of the Blazor package, which reaches them through
         Microsoft.AspNetCore.Components.Web and Microsoft.Extensions.Localization, of the Orleans package, which
         reaches them through Microsoft.Orleans.Serialization, and of the Marten package, which reaches them through
         JasperFx: removing them changes what those ten pack. Dependabot never moves them, so an update of a package that asks for a later version of either fails the
         restore with NU1109, and opens no pull request, until they are raised by hand with it. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.13" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Swashbuckle 10 builds on Microsoft.OpenApi 2, whose pin above is the Swashbuckle package's floor. Its next major is
         a decision, not a bump (docs/adr/0010-version-every-package-in-lockstep-independently-of-dotnet.md). No version is
         pinned for Swashbuckle.AspNetCore.Swagger, which the tests take through it: a pin would make it a dependency of
         the package. -->
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.3.0" />
    <!-- The Serilog package's floor, the version it is built against
         (docs/adr/0010-version-every-package-in-lockstep-independently-of-dotnet.md). Its net10.0 asset depends on
         nothing. -->
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <!-- The MongoDB package's floor, the version it is built against
         (docs/adr/0010-version-every-package-in-lockstep-independently-of-dotnet.md). MongoDB.Bson comes with it, at the
         same version, and is pinned by nothing here: a pin would make it a dependency of the package. -->
    <PackageVersion Include="MongoDB.Driver" Version="3.12.0" />
    <!-- The Marten package's floor, the version it is built against
         (docs/adr/0010-version-every-package-in-lockstep-independently-of-dotnet.md); Marten 10 is a decision, not a bump.
         JasperFx, JasperFx.Events, Weasel and Npgsql come with it and are pinned by nothing here: a pin would make them
         dependencies of the package. Marten asks for Npgsql 9.0.4, which the suites resolve at 10.0.3 through the Entity
         Framework Core provider. -->
    <PackageVersion Include="Marten" Version="9.50.3" />
    <!-- The MessagePack package's floors, the versions it is built against
         (docs/adr/0010-version-every-package-in-lockstep-independently-of-dotnet.md). MessagePack 3 lifts the 2.5.302 the
         hub protocol asks for. MessagePack.Annotations and MessagePackAnalyzer come with MessagePack and are pinned by
         nothing here: a pin would make them dependencies of the package. -->
    <PackageVersion Include="MessagePack" Version="3.1.11" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.13" />
    <!-- The test-data packages' floors, the versions they are built against
         (docs/adr/0010-version-every-package-in-lockstep-independently-of-dotnet.md). AutoFixture stays on 4.18.1 while
         5.0 is a release candidate: a stable package depending on a prerelease is NU5104, which fails the pack. Fare,
         which AutoFixture brings, and FSharp.Core, which FsCheck brings, are pinned by nothing here: a pin would make them
         dependencies of the packages. -->
    <PackageVersion Include="AutoFixture" Version="4.18.1" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="FsCheck" Version="3.4.0" />
    <!-- The AI package's floor, the version it is built against
         (docs/adr/0010-version-every-package-in-lockstep-independently-of-dotnet.md). Its net10.0 asset depends on
         nothing. -->
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.1" />
    <!-- The Model Context Protocol package's floor, the version it is built against
         (docs/adr/0010-version-every-package-in-lockstep-independently-of-dotnet.md). ModelContextProtocol.Core comes with
         it at exactly that version, and Microsoft.Extensions.Hosting.Abstractions and Caching.Abstractions at their
         floors; none is pinned here: a pin would make it a dependency of the package. -->
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <!-- The Azure Functions packages' floors, the versions they are built against
         (docs/adr/0010-version-every-package-in-lockstep-independently-of-dotnet.md). Microsoft's own worker extensions
         (Application Insights, OpenTelemetry, Durable Functions) take Worker.Core at 2.51 and 2.52 too. Azure.Core and
         Microsoft.Extensions.Hosting come with Worker.Core, and the Http extension and its analyzer with
         Extensions.Http.AspNetCore; none is pinned here: a pin would make it a dependency of the packages. -->
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Core" Version="2.52.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.1" />
    <!-- No package under src/ references it: the Functions application the integration suite runs does, and the unit
         suite takes it through this pin. A transitive pin: Extensions.Http.AspNetCore asks for 2.1.0, whose Worker.Grpc would run beside Worker.Core
         2.52.0, and pinning lists it as a dependency of AdCodicem.ValueObjects.AzureFunctions.AspNetCore, so that an HTTP
         application takes the worker at the version of its core: removing it changes what that package packs. -->
    <PackageVersion Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <!-- The HotChocolate package's floor, the version it is built against
         (docs/adr/0010-version-every-package-in-lockstep-independently-of-dotnet.md); HotChocolate 17 is a decision, not a
         bump. Its other HotChocolate and GreenDonut packages come with it, at exactly its version, and are pinned by
         nothing here: a pin would make them dependencies of the package. -->
    <PackageVersion Include="HotChocolate.Types" Version="16.6.8" />
    <!-- The HotChocolate.Data package's floor, the version it is built against, HotChocolate.Types'
         (docs/adr/0010-version-every-package-in-lockstep-independently-of-dotnet.md). Its GreenDonut.Data,
         HotChocolate.Execution.Projections and other packages come with it, at exactly its version, and are pinned by
         nothing here: a pin would make them dependencies of the package. -->
    <PackageVersion Include="HotChocolate.Data" Version="16.6.8" />
    <!-- IStringLocalizerFactory, for the HotChocolate package's localized messages; its net10.0 asset depends on nothing.
         The HotChocolate.Data package takes it through the HotChocolate package, and the Blazor package through
         Microsoft.Extensions.Localization, and pinning lists it as a dependency of both too. -->
    <PackageVersion Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.13" />
    <!-- The Blazor package's floors, the versions it is built against
         (docs/adr/0010-version-every-package-in-lockstep-independently-of-dotnet.md): the package rather than the
         ASP.NET Core shared framework, which a Blazor WebAssembly application lacks, and the localization services
         AddValueObjectInputs registers. Microsoft.AspNetCore.Components, its Forms and JSInterop come with
         Components.Web, at exactly its version, and are pinned by nothing here: a pin would make them dependencies of the
         package. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="10.0.13" />
    <!-- The NJsonSchema package's floor, the version it is built against, which NSwag 14.7 asks for
         (docs/adr/0010-version-every-package-in-lockstep-independently-of-dotnet.md); Confluent's JSON serdes take
         NJsonSchema.NewtonsoftJson 11.0.2 or later. Namotion.Reflection and NJsonSchema.Annotations come with it and are
         pinned by nothing here: a pin would make them dependencies of the package. -->
    <PackageVersion Include="NJsonSchema" Version="11.6.1" />
    <PackageVersion Include="NJsonSchema.NewtonsoftJson" Version="11.6.1" />
    <!-- The protobuf-net package's floors, the versions it is built against
         (docs/adr/0010-version-every-package-in-lockstep-independently-of-dotnet.md). protobuf-net.Grpc asks for
         protobuf-net 2.4.8, which the direct reference lifts. protobuf-net.Core and Grpc.Core.Api come with them and are
         pinned by nothing here: a pin would make them dependencies of the package. -->
    <PackageVersion Include="protobuf-net" Version="3.4.30" />
    <PackageVersion Include="protobuf-net.Grpc" Version="1.3.14" />
    <!-- The gRPC package's floor, the version it is built against
         (docs/adr/0010-version-every-package-in-lockstep-independently-of-dotnet.md). Grpc.Core.Api,
         Google.Api.CommonProtos and Google.Protobuf come with it and are pinned by nothing here: a pin would make them
         dependencies of the package. -->
    <PackageVersion Include="Grpc.StatusProto" Version="2.84.0" />
    <!-- The Orleans package's floor, the version it is built against
         (docs/adr/0010-version-every-package-in-lockstep-independently-of-dotnet.md); Orleans 11 is a decision, not a bump.
         Microsoft.Orleans.Serialization.Abstractions comes with it at exactly its version, and the Roslyn packages it lists
         though its assembly loads none; none is pinned here but Microsoft.CodeAnalysis.Analyzers, above. -->
    <PackageVersion Include="Microsoft.Orleans.Serialization" Version="10.4.0" />
    <!-- The System.CommandLine package's floor, the version it is built against
         (docs/adr/0010-version-every-package-in-lockstep-independently-of-dotnet.md); its net8.0 asset depends on nothing.
         3.0, whose version follows .NET 11's, runs the package as built (tests/Compat); its next major is a decision, not a
         bump. -->
    <PackageVersion Include="System.CommandLine" Version="2.0.13" />
    <!-- The CsvHelper package's floor, the version it is built against
         (docs/adr/0010-version-every-package-in-lockstep-independently-of-dotnet.md), and CsvHelper's latest release, of
         2025-06-02; its net8.0 and net9.0 assets depend on nothing. -->
    <PackageVersion Include="CsvHelper" Version="33.1.0" />
    <!-- The Wolverine.Http package's floor, the version it is built against
         (docs/adr/0010-version-every-package-in-lockstep-independently-of-dotnet.md), below which the tests do not build
         (RejectUnparseableQueryValues came after 6.0); Wolverine 7 is a decision, not a bump. WolverineFx, JasperFx,
         JasperFx.Events, JasperFx.SourceGenerator and the rest come with it and are pinned by nothing here: a pin would
         make them dependencies of the package. The Microsoft.Extensions pins above are pruned by its ASP.NET Core
         framework reference. -->
    <PackageVersion Include="WolverineFx.Http" Version="6.51.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.1" />
    <PackageVersion Include="xunit.v3.assert" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.MongoDb" Version="4.15.0" />
    <!-- Azurite, the storage emulator the Functions host's queue triggers run on in the integration suite, and the client
         that enqueues their messages; no package under src/ references them. -->
    <PackageVersion Include="Testcontainers.Azurite" Version="4.15.0" />
    <PackageVersion Include="Azure.Storage.Queues" Version="12.28.1" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <!-- Pinned explicitly: Microsoft.Data.SqlClient, which the SQL Server provider brings, asks for 9.0.11, which carries
         GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7. Only the SQL Server tests, the sample and the compiled model reach
         it, the last through a reference of its own, since it turns transitive pinning off; no package under src/ does,
         so it ships nowhere. Remove it, and that reference, once SqlClient asks for a patched version. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- An engine in memory, which needs no server and through which the unit suite runs what only an engine shows:
         primitive collections of value objects, their JSON included, the keys it generates, `.Value` translated in
         queries, and the CHECK constraints accepting and refusing rows; no package under src/ references it. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <!-- A provider that is not relational, on which the unit suite checks that an integer key is not generated; no
         package under src/ references it. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.13" />
    <!-- What `dotnet ef dbcontext optimize` loads into the project it compiles a model for: the version of the dotnet-ef
         tool in .config/dotnet-tools.json, which is Entity Framework Core's. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
    <!-- The .NET client the unit suite connects to a hub through, over TestHost; no package under src/ references it. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <!-- bUnit's renderer, which the unit suite's Forms/ drives the Blazor package's input through, as a test of an
         application's form does; no package under src/ references it. It asks for Components 10.0.10, which the pin of
         Microsoft.AspNetCore.Components.Web lifts, and the suite loads the shared framework's Components assemblies. -->
    <PackageVersion Include="bunit" Version="2.11.3" />
    <!-- ObservableValidator, the view model base that validates DataAnnotations attributes as a property is set, which
         the unit suite runs [ParsesAs] and [NotDefault] through; no package under src/ references it. -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Basic.Reference.Assemblies.Net100" Version="1.8.12" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- Validates what the serializer writes against the JSON Schema exported for it, under draft 2020-12, the draft
         System.Text.Json exports. BSD-3-Clause, as is the package of its author it depends on, the others being
         Microsoft's, under MIT; JsonSchema.Net, which it replaces, moved to the Open Source Maintenance Fee EULA at 9.0. -->
    <PackageVersion Include="LateApexEarlySpeed.Json.Schema" Version="4.2.0" />
    <!-- The attribute a consumer derives to classify a value object as personal data, which the generator recognizes
         by name: the tests classify value objects as a consumer does, and no package under src/ references it. At the
         version Microsoft.Extensions.Telemetry.Abstractions asks for, which a lower pin would fail the restore of
         (NU1109). -->
    <PackageVersion Include="Microsoft.Extensions.Compliance.Abstractions" Version="10.11.0" />
    <!-- The logging generator, Microsoft.Gen.Logging, which the generator tests run over snippets and the Redaction
         fixture compiles with, and LogPropertiesAttribute; it replaces Microsoft.Extensions.Logging's [LoggerMessage]
         generator in every project it reaches. EnableRedaction(), which the unit suite logs through, and the redactors it
         registers. No package under src/ references them. -->
    <PackageVersion Include="Microsoft.Extensions.Telemetry.Abstractions" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Telemetry" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Compliance.Redaction" Version="10.11.0" />
    <!-- The formatter, the filter language and the Microsoft.Extensions.Logging provider the unit suite drives the Serilog
         package through, as an application does; no package under src/ references them. -->
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="Serilog.Expressions" Version="5.0.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <!-- FunctionInvokingChatClient and ChatResponse<T>, which the unit suite drives the AI package through, as an
         application does, and the OpenAI adapter whose strict-mode request it captures; no package under src/ references
         them. Microsoft.Extensions.AI has no 10.10.1. -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
    <!-- Agent Framework's ChatClientAgent, which the unit suite runs the AI package's tools and response format through,
         as an application does; no package under src/ references it. -->
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.24.0" />
    <!-- The Functions application the integration suite runs in the host's container: the worker's build, and the queue
         trigger whose binding data it reads; no package under src/ references them. -->
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.1.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Storage.Queues" Version="5.5.5" />
    <!-- What the unit suite drives the HotChocolate packages through, as an application does: the HTTP endpoint and, in a
         fixture, HotChocolate's source generator; no package under src/ references them. -->
    <PackageVersion Include="HotChocolate.AspNetCore" Version="16.6.8" />
    <PackageVersion Include="HotChocolate.Types.Analyzers" Version="16.6.8" />
    <!-- NSwag's document generation over TestHost and its C# client generator, and Confluent's JSON serdes for the Schema
         Registry over a substitute registry client, which the unit suite drives the NJsonSchema package through, as an
         application does; no package under src/ references them. The Kafka client's native library comes with the serdes
         and is pinned only so that the suite can leave its 105 MB out of its output: the serdes never load it. -->
    <PackageVersion Include="NSwag.AspNetCore" Version="14.7.1" />
    <PackageVersion Include="NSwag.CodeGeneration.CSharp" Version="14.7.1" />
    <PackageVersion Include="Confluent.SchemaRegistry.Serdes.Json" Version="2.16.0" />
    <PackageVersion Include="librdkafka.redist" Version="2.16.0" />
    <!-- What the unit suite drives the protobuf-net package's code-first binder and the gRPC package through, as an
         application does: a protobuf-net.Grpc server over TestHost, Grpc.AspNetCore's server, Grpc.Tools, which compiles
         the contract-first service's .proto, and, through its client factory, Grpc.Net.Client; no package under src/
         references them. Google.Protobuf, Grpc.Core.Api and Grpc.Net.Client come with them and are pinned by nothing
         here: a pin would make them dependencies of every package whose restore graph holds them. -->
    <PackageVersion Include="protobuf-net.Grpc.AspNetCore" Version="1.3.14" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.84.0" />
    <!-- What the unit suite drives the Orleans package through, as an application does: Orleans' code generator, which
         writes the codecs and proxies of a fixture's grains and holders, and an in-process cluster, a silo and its client
         talking over localhost through the same serializer; no package under src/ references them. TestingHost depends
         on Microsoft.Orleans.DurableJobs 10.4.0-alpha.1, a prerelease, harmless in a test project, and brings Orleans'
         generator, analyzers and global usings with it, through Microsoft.Orleans.Sdk. -->
    <PackageVersion Include="Microsoft.Orleans.Sdk" Version="10.4.0" />
    <PackageVersion Include="Microsoft.Orleans.TestingHost" Version="10.4.0" />
    <!-- Wolverine's dynamic mode, which compiles each endpoint's generated code at run time with Roslyn 5.0.0: the
         Wolverine.Http fixture application alone references it, and takes its Roslyn through the conditional pins above;
         no package under src/ references it. -->
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.51.0" />
  </ItemGroup>

</Project>
