<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AdCodicem.ValueObjects</RootNamespace>
    <Description>Dependency-free contracts for single-value DDD value objects: IValueObject&lt;TSelf, TValue&gt; with static abstract factories, allocation-free validation results and a runtime descriptor registry.</Description>
    <PackageTags>$(PackageTags);abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- The reader of a .NET pattern, compiled into every package that writes one in another dialect: an XSD pattern here. -->
    <Compile Include="..\Shared\ValueObjectPatternSyntax.cs" Link="Shared\ValueObjectPatternSyntax.cs" />
  </ItemGroup>

</Project>
