<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AdCodicem.ValueObjects</RootNamespace>
    <Description>Dependency-free contracts for single-value DDD value objects: IValueObject&lt;TSelf, TValue&gt; with static abstract factories, allocation-free validation results, a runtime descriptor registry, and the DataAnnotations attributes [ParsesAs] and [NotDefault], which hold raw text and a value-object member to a value object's rules.</Description>
    <PackageTags>$(PackageTags);abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- The reader of a .NET pattern, compiled into every package that writes one in another dialect: an XSD pattern here. -->
    <Compile Include="..\Shared\ValueObjectPatternSyntax.cs" Link="Shared\ValueObjectPatternSyntax.cs" />
    <!-- The lookup of a refusal's message in the resource a DataAnnotations attribute names, through a ResourceManager,
         with no services. -->
    <Compile Include="..\Shared\ValueObjectResourceMessages.cs" Link="Shared\ValueObjectResourceMessages.cs" />
  </ItemGroup>

</Project>
