<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AdCodicem.ValueObjects.AspNetCore.Http</RootNamespace>
    <Description>Minimal API support for AdCodicem value objects: RFC 9457 problem details carrying the violated rule's code for a route, query or header value the binder refuses, and for a request body when ThrowOnBadRequest is on. AOT-compatible.</Description>
    <PackageTags>$(PackageTags);aspnetcore;minimal-api;problemdetails;native-aot</PackageTags>

    <!--
      AOT-compatible, by the repository's default, unlike the MVC package: minimal APIs are the way to native AOT, and
      the endpoint filter and the exception handler read nothing a native binary lacks. Each parameter's check is closed
      over its value object through the descriptor's visitor, never with MakeGenericType.
    -->
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdCodicem.ValueObjects.Abstractions\AdCodicem.ValueObjects.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The lookup of a refusal's message in the application's resource, compiled into the MVC and the Azure Functions
         ASP.NET Core packages too, which see none of this one's internals, and, without its ASP.NET Core part, into the
         HotChocolate and Blazor packages. -->
    <Compile Include="..\Shared\ValueObjectLocalizedMessages.cs" Link="Shared\ValueObjectLocalizedMessages.cs" />
    <Compile Include="..\Shared\ValueObjectLocalizedMessages.AspNetCore.cs" Link="Shared\ValueObjectLocalizedMessages.AspNetCore.cs" />
    <!-- The refusal list and its validation problem, which the Azure Functions ASP.NET Core package compiles too; the
         refusal of a request body is this package's own part (Binding\ValueObjectRefusals.Body.cs). -->
    <Compile Include="..\Shared\ValueObjectRefusals.cs" Link="Shared\ValueObjectRefusals.cs" />
  </ItemGroup>

</Project>
