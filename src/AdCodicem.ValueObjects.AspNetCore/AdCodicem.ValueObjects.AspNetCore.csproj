<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AdCodicem.ValueObjects.AspNetCore</RootNamespace>
    <Description>ASP.NET Core support for AdCodicem value objects: MVC model binding straight from the underlying value, and RFC 9457 problem details carrying the violated rule.</Description>
    <PackageTags>$(PackageTags);aspnetcore;model-binding;problemdetails</PackageTags>

    <!--
      This package exists for MVC controllers, whose model binding is reflection-driven and not AOT compatible
      to begin with. Minimal APIs need nothing from it to bind: a generated value object implements IParsable<T>,
      which is exactly what minimal API parameter binding looks for. The problem details carrying the rule's code
      extend ApiBehaviorOptions here, which only MVC reads; minimal APIs get theirs from AdCodicem.ValueObjects.AspNetCore.Http,
      which is AOT-compatible, and which this package references for ValueObjectProblemDetails, the member name both write.
      Under the Request Delegate Generator, which does not see that interface on a value object of its own
      project, the value object lists it on its declaration (VO0033); no package can change what one generator
      sees of another's output.
    -->
    <IsAotCompatible>false</IsAotCompatible>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdCodicem.ValueObjects.Abstractions\AdCodicem.ValueObjects.Abstractions.csproj" />
    <ProjectReference Include="..\AdCodicem.ValueObjects.AspNetCore.Http\AdCodicem.ValueObjects.AspNetCore.Http.csproj" />
    <ProjectReference Include="..\AdCodicem.ValueObjects.Json\AdCodicem.ValueObjects.Json.csproj" />
  </ItemGroup>

</Project>
