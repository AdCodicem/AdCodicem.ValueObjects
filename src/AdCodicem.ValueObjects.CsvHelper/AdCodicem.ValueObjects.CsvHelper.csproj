<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AdCodicem.ValueObjects.CsvHelper</RootNamespace>
    <Description>CsvHelper support for AdCodicem value objects: each value object a single column, written as its own text, which its parser reads back, and read through its rules, a refused field throwing CsvHelper's TypeConverterException with the rule's code in its Data, an empty field refused as required unless the member is nullable, and an uninitialized instance its rules refuse never written. AOT-compatible code; CsvHelper's record API itself does not run natively.</Description>
    <PackageTags>$(PackageTags);csv;csvhelper;import;export</PackageTags>

    <!--
      AOT-compatible, by the repository's default: each converter is closed over its value object through the
      descriptor's visitor, never with MakeGenericType, and a value object nothing registered is described by reflection
      only where the runtime supports dynamic code; CsvHelper's GetField<T> and WriteField<T> run natively through the
      package. CsvHelper 33.1 carries no trimming annotation and builds the maps of its record API by reflection
      (DefaultClassMap<T>, MemberMap<TClass, TMember>), which fails in a native binary with MissingMethodException:
      tests/NativeAot leaves the package out.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdCodicem.ValueObjects.Abstractions\AdCodicem.ValueObjects.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DefaultTypeConverter, ITypeConverterFactory (since 29.0) and TypeConverterCache; its net8.0 and net9.0 assets
         depend on nothing. -->
    <PackageReference Include="CsvHelper" />
  </ItemGroup>

  <ItemGroup>
    <!-- How the text of a value object is read and written for a person, a date in the Gregorian calendar whatever the
         culture's, which the Blazor and System.CommandLine packages compile too. -->
    <Compile Include="..\Shared\ValueObjectText.cs" Link="Shared\ValueObjectText.cs" />
    <!-- A type as C# names it, for the message of a refused field and of a value object this package cannot describe. -->
    <Compile Include="..\Shared\TypeNames.cs" Link="Shared\TypeNames.cs" />
  </ItemGroup>

</Project>
