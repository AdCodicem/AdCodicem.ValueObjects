<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AdCodicem.ValueObjects.EntityFrameworkCore</RootNamespace>
    <Description>Entity Framework Core support for AdCodicem value objects: value converters and comparers that store the bare underlying value, plus a convention that maps every value object of an assembly in one call, keys generated the provider's way, .Value translated in LINQ queries to the column itself, and opt-in CHECK constraints from the rules each value object declares.</Description>
    <PackageTags>$(PackageTags);efcore;entity-framework;persistence</PackageTags>

    <!-- Entity Framework Core builds its model by reflection, so this package cannot claim AOT compatibility. -->
    <IsAotCompatible>false</IsAotCompatible>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdCodicem.ValueObjects.Abstractions\AdCodicem.ValueObjects.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <!-- Whether a closed set of text stores another spelling of a known value, which the IN of a CHECK constraint needs. -->
    <Compile Include="..\Shared\KnownValueSpellings.cs" Link="Shared\KnownValueSpellings.cs" />
    <!-- The names of the types its refusals show, written as C# names them: a key, a value object and its pattern. -->
    <Compile Include="..\Shared\TypeNames.cs" Link="Shared\TypeNames.cs" />
    <!-- The reader of a .NET pattern, which a CHECK constraint writes in the dialect of the database. -->
    <Compile Include="..\Shared\ValueObjectPatternSyntax.cs" Link="Shared\ValueObjectPatternSyntax.cs" />
  </ItemGroup>

</Project>
