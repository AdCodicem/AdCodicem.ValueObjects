<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AdCodicem.ValueObjects.FluentValidation</RootNamespace>
    <Description>FluentValidation rules that reuse the rules a value object already enforces, so a request or command validator never restates them.</Description>
    <PackageTags>$(PackageTags);fluentvalidation;validation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdCodicem.ValueObjects.Abstractions\AdCodicem.ValueObjects.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

</Project>
