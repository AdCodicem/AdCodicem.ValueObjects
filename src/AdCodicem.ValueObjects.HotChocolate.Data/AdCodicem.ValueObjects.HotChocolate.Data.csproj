<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AdCodicem.ValueObjects.HotChocolate.Data</RootNamespace>
    <Description>HotChocolate.Data support for AdCodicem value objects: every value object a filter meets is filtered through the comparable operations of its GraphQL scalar, its operands read through its rules and a refused one answered with the rule's code, translated to its column by Entity Framework Core, with no binding per type; contains, startsWith and endsWith over the underlying text on request. AOT-compatible code; HotChocolate.Data's filtering itself does not run natively.</Description>
    <PackageTags>$(PackageTags);graphql;hotchocolate;filtering</PackageTags>

    <!-- HotChocolate.Data's build/ targets add `global using HotChocolate.Data` under ImplicitUsings: this project names
         HotChocolate's types through usings of its own. The targets come with a direct reference only, so they reach no
         consumer through this package. -->
    <HotChocolateImplicitUsings>disable</HotChocolateImplicitUsings>

    <!--
      AOT-compatible, by the repository's default: the operation types are closed over each value object through the
      descriptor's visitor, never with MakeGenericType, and the type interceptor is created by a factory, whose
      constructor the AOT compiler keeps. HotChocolate.Data itself closes generic methods over a member's type at run
      time, and its filtering of a struct has no native code (the integration guide): tests/NativeAot leaves the package
      out.
    -->
  </PropertyGroup>

  <ItemGroup>
    <!-- The scalars, which the operands of a filter are, and their options; the contracts come with it. -->
    <ProjectReference Include="..\AdCodicem.ValueObjects.HotChocolate\AdCodicem.ValueObjects.HotChocolate.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The filter convention, its input types and the queryable provider's handlers. -->
    <PackageReference Include="HotChocolate.Data" />
  </ItemGroup>

</Project>
