<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AdCodicem.ValueObjects.Marten</RootNamespace>
    <Description>Marten support for AdCodicem value objects: LINQ queries, duplicated fields and their columns over the underlying value, Contains and IsOneOf over value objects, a compiled query's collection of value objects bound on every call and a single one refused rather than answered with the value of its first call, the converter factory in the store's System.Text.Json serializer, and values a query projects read back through the rules with the rule's code.</Description>
    <PackageTags>$(PackageTags);marten;postgresql;document-database;event-sourcing;linq</PackageTags>

    <!--
      AOT-compatible, by the repository's default: each value object is closed over through the descriptor's visitor,
      never with MakeGenericType, a value object nothing registered is described by reflection only where the runtime
      supports dynamic code, and the select clause Marten's member closes with Activator.CreateInstance is kept per value
      object. Marten 9.50's own publish warns for Marten, JasperFx, Weasel and FastExpressionCompiler, and its run needs
      PostgreSQL: tests/NativeAot/AdCodicem.ValueObjects.NativeAot.Marten runs it natively against PostgreSQL, apart from
      the main application, and lets those warnings through by list.
    -->
  </PropertyGroup>

  <ItemGroup>
    <!-- The converter factory, which the store's serializer needs for a source-generated resolver and a value object
         written by hand; Abstractions comes with it. -->
    <ProjectReference Include="..\AdCodicem.ValueObjects.Json\AdCodicem.ValueObjects.Json.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Marten's members, member sources, method-call parsers and compiled-query plan; JasperFx, JasperFx.Events,
         Weasel and Npgsql come with it. -->
    <PackageReference Include="Marten" />
  </ItemGroup>

  <ItemGroup>
    <!-- A type as C# names it, for the value object and the compiled query a refusal names. -->
    <Compile Include="..\Shared\TypeNames.cs" Link="Shared\TypeNames.cs" />
  </ItemGroup>

  <!--
    Marten bundles JasperFx.Events.SourceGenerator in its own analyzers folder, which reaches this project through its
    direct reference (never a consumer: the nuspec excludes Analyzers). It finds no aggregate here, and would only stamp
    [assembly: JasperFxSourceGeneratorApplied] into the package's assembly, JasperFx's evidence that it ran: removed once
    the references are resolved, so that the assembly holds the package's code alone.
  -->
  <Target Name="LeaveJasperFxGeneratorsOut" AfterTargets="ResolveReferences">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.Filename)' == 'JasperFx.Events.SourceGenerator'" />
    </ItemGroup>
  </Target>

</Project>
