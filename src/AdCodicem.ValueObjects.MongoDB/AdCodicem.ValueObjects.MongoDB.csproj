<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AdCodicem.ValueObjects.MongoDB</RootNamespace>
    <Description>MongoDB.Driver serializers for AdCodicem value objects: each stored as the bare value its underlying type writes, LINQ queries over .Value translated to the field, strict reads through the value object's rules by default, and a value the type refuses never written.</Description>
    <PackageTags>$(PackageTags);mongodb;bson;nosql;cosmosdb</PackageTags>

    <!-- MongoDB.Driver maps documents through class maps it builds by reflection, so this package cannot claim AOT
         compatibility. -->
    <IsAotCompatible>false</IsAotCompatible>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdCodicem.ValueObjects.Abstractions\AdCodicem.ValueObjects.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" />
  </ItemGroup>

</Project>
