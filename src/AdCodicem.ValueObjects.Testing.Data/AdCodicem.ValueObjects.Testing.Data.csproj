<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AdCodicem.ValueObjects.Testing.Data</RootNamespace>
    <Description>A dependency-free sampler of AdCodicem value objects for tests: values each type accepts, drawn from the rules it declares (lengths, pattern, bounds, known values) and kept only once its rules accept them, with the values at its edges and the values its schema rules out, for any test framework.</Description>
    <PackageTags>$(PackageTags);testing;test-data;property-based-testing</PackageTags>

    <!-- Test-only, as AdCodicem.ValueObjects.Testing. -->
    <IsAotCompatible>false</IsAotCompatible>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdCodicem.ValueObjects.Abstractions\AdCodicem.ValueObjects.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The reader of a .NET pattern, whose tree the sampler draws strings from. -->
    <Compile Include="..\Shared\ValueObjectPatternSyntax.cs" Link="Shared\ValueObjectPatternSyntax.cs" />
    <!-- The names of the registration a message shows, which the AutoFixture, Bogus and FsCheck packages write too. -->
    <Compile Include="..\Shared\TypeNames.cs" Link="Shared\TypeNames.cs" />
  </ItemGroup>

</Project>
