<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AdCodicem.ValueObjects.Wolverine.Http</RootNamespace>
    <Description>Wolverine.Http support for AdCodicem value objects: each value-object parameter of an endpoint bound from its route value, query value, header or form field through its rules, and a refused or missing one answered 400 with RFC 9457 problem details carrying the violated rule's code, as minimal APIs answer it, every refusal of a request at once. AOT-compatible in Wolverine's static mode.</Description>
    <PackageTags>$(PackageTags);wolverine;wolverinefx;aspnetcore;problemdetails</PackageTags>

    <!--
      AOT-compatible, by the repository's default: the code Wolverine generates for an endpoint names each value object,
      so TSelf.TryParse is closed at compile time, with no visitor and no MakeGenericType, and the registry is never asked.
      The strategy runs while Wolverine builds its endpoints at startup, in static mode too, through one interface lookup
      whose trimming warning is suppressed with the registry's justification. tests/NativeAot/AdCodicem.ValueObjects.NativeAot
      runs it natively in static mode, over the code codegen write writes first.
    -->
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- ValueObjectProblemDetails and ValueObjectMessageOptions, the member name and the messages this package shares with
         the minimal API, MVC and Azure Functions packages. -->
    <ProjectReference Include="..\AdCodicem.ValueObjects.AspNetCore.Http\AdCodicem.ValueObjects.AspNetCore.Http.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- IParameterStrategy, IHttpPolicy, HttpChain and the WolverineHttpOptions UseValueObjects extends; WolverineFx and
         JasperFx's code generation, whose frames the package writes, come with it. -->
    <PackageReference Include="WolverineFx.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- The refusal list and its validation problem, and the lookup of a refusal's message in the application's resource,
         compiled here too rather than reached through InternalsVisibleTo: the packages are installed apart, and an
         internal of one is no contract of the other. -->
    <Compile Include="..\Shared\ValueObjectRefusals.cs" Link="Shared\ValueObjectRefusals.cs" />
    <Compile Include="..\Shared\ValueObjectLocalizedMessages.cs" Link="Shared\ValueObjectLocalizedMessages.cs" />
    <Compile Include="..\Shared\ValueObjectLocalizedMessages.AspNetCore.cs" Link="Shared\ValueObjectLocalizedMessages.AspNetCore.cs" />
  </ItemGroup>

  <!--
    WolverineFx lists JasperFx.SourceGenerator with include="All", which reaches this project despite WolverineFx.Http's
    exclude="Build,Analyzers". It finds no event model here, and would only write an empty internal
    JasperFx.Generated.DiscoveredEventModels into the package's assembly: removed once the references are resolved, so
    that the assembly holds the package's code alone.
  -->
  <Target Name="LeaveJasperFxGeneratorsOut" AfterTargets="ResolveReferences">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.NuGetPackageId)' == 'JasperFx.SourceGenerator'" />
    </ItemGroup>
  </Target>

</Project>
