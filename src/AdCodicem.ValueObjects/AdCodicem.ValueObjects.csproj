<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AdCodicem.ValueObjects</RootNamespace>
    <Description>An answer to primitive obsession: single-value DDD value objects for .NET. Annotate a readonly partial struct with [ValueObject&lt;T&gt;] and get validation, normalization, parsing, formatting, comparison, JSON and type conversion generated with no reflection and no allocation. This is the package to install.</Description>
    <PackageTags>$(PackageTags);source-generator;analyzer</PackageTags>

    <!-- The assembly carries no code of its own: it exists to bundle the contracts with the generator. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <EnablePackageValidation>false</EnablePackageValidation>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackValueObjectGenerator</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdCodicem.ValueObjects.Abstractions\AdCodicem.ValueObjects.Abstractions.csproj" />
    <ProjectReference Include="..\AdCodicem.ValueObjects.Generators\AdCodicem.ValueObjects.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Include="..\AdCodicem.ValueObjects.CodeFixes\AdCodicem.ValueObjects.CodeFixes.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <!-- Makes EnableRequestDelegateGenerator visible to VO0033, in the consumer's project and in those referencing it. -->
  <ItemGroup>
    <None Include="build\AdCodicem.ValueObjects.props" Pack="true" PackagePath="build\;buildTransitive\" />
  </ItemGroup>

  <Target Name="PackValueObjectGenerator" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(Analyzer)"
                              Condition="'%(Analyzer.Filename)' == 'AdCodicem.ValueObjects.Generators' or '%(Analyzer.Filename)' == 'AdCodicem.ValueObjects.CodeFixes'"
                              PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

</Project>
