<Project>

  <!--
    An analyzer reads a build property only when the project lists it here. VO0033 reports a value object the Request
    Delegate Generator cannot see as parsable: the SDK turns that generator on through EnableRequestDelegateGenerator,
    which it sets under PublishAot and PublishTrimmed. VO0042 reports, under PublishAot, a [ParsesAs(typeof(T))] naming
    a value object a native binary finds only once it is registered by hand. NuGet imports this file into the projects
    that reference the package and, from buildTransitive/, into those that reference it through another project.
  -->
  <ItemGroup>
    <CompilerVisibleProperty Include="EnableRequestDelegateGenerator" />
    <CompilerVisibleProperty Include="PublishAot" />
  </ItemGroup>

</Project>
