<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!--
    release-pack.sh holds each package to the API of the previous release, except one that nuget.org does not have
    at that version (a package added since), whose baseline would fail to restore. It passes the version and the
    projects to leave out. They are named by project rather than by PackageId, which NuGet's pack targets only
    default later in the evaluation.
  -->
  <PropertyGroup Condition="'$(ReleaseBaselineVersion)' != '' and !$([System.String]::Copy(' $(ProjectsWithoutBaseline) ').Contains(' $(MSBuildProjectName) '))">
    <PackageValidationBaselineVersion>$(ReleaseBaselineVersion)</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" Condition="'$(GITHUB_ACTIONS)' == 'true'" />
  </ItemGroup>

  <!-- A package README, preferring one written for the package and falling back to the repository's. -->
  <ItemGroup Condition="Exists('README.md')">
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('README.md')">
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!--
    Release notes on nuget.org point back to GitHub. A stable package links to its own GitHub Release, which
    semantic-release creates with the tag right after the push. A preview has no release of its own, so it links
    to the changelog. The version is only known once MinVer has run, hence a target rather than a property.
  -->
  <Target Name="_SetPackageReleaseNotes" AfterTargets="MinVer">
    <PropertyGroup>
      <PackageReleaseNotes Condition="'$(MinVerPreRelease)' == ''">$(RepositoryUrl)/releases/tag/v$(PackageVersion)</PackageReleaseNotes>
      <PackageReleaseNotes Condition="'$(MinVerPreRelease)' != ''">$(RepositoryUrl)/blob/main/CHANGELOG.md</PackageReleaseNotes>
    </PropertyGroup>
  </Target>

  <!-- The three shared suites, not one per package: an internal member no input reaches is tested directly
       (docs/adr/0006-coverage-is-a-signal-not-a-goal.md), and only these assemblies exist to do it. -->
  <ItemGroup>
    <InternalsVisibleTo Include="AdCodicem.ValueObjects.UnitTests" />
    <InternalsVisibleTo Include="AdCodicem.ValueObjects.GeneratorTests" />
    <InternalsVisibleTo Include="AdCodicem.ValueObjects.IntegrationTests" />
  </ItemGroup>
</Project>
