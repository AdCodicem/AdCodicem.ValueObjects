<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!--
    The release train of the project (src/release-trains.json,
    docs/adr/0012-version-the-packages-in-two-trains-independently-of-the-frameworks.md), read at evaluation. MSBuild
    has no JSON parser, so a regular expression finds the innermost object holding the project's name as a string,
    whatever the order of its keys, and otherwise takes the train whose projects are "*";
    .github/scripts/release-trains.mjs check refuses any list it could misread, and ci.yml compares the two readings
    at every pack. A missing list fails the evaluation (MSB4184) rather than default to a train.

    RELEASE_TRAIN_VERSIONS ("core=1.2.0 satellites=0.4.0") gives each train its version from outside, which MinVer
    takes as its override: it replaces MINVERVERSIONOVERRIDE, one version for every project, which
    src/Directory.Build.targets refuses, as it refuses a train left without a version. Without it, MinVer derives the
    version from the tags.
  -->
  <PropertyGroup Label="Release train">
    <_ReleaseTrains>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)release-trains.json'))</_ReleaseTrains>
    <ReleaseTrain>$([System.Text.RegularExpressions.Regex]::Match($(_ReleaseTrains), '"([a-z][a-z0-9-]*)"\s*:\s*\{[^{}]*"$([System.Text.RegularExpressions.Regex]::Escape($(MSBuildProjectName)))"').Groups[1].Value)</ReleaseTrain>
    <ReleaseTrain Condition="'$(ReleaseTrain)' == ''">$([System.Text.RegularExpressions.Regex]::Match($(_ReleaseTrains), '"([a-z][a-z0-9-]*)"\s*:\s*\{[^{}]*"projects"\s*:\s*"\*"').Groups[1].Value)</ReleaseTrain>
    <_InheritedMinVerVersionOverride>$(MinVerVersionOverride)</_InheritedMinVerVersionOverride>
    <_ReleaseTrainVersion Condition="'$(RELEASE_TRAIN_VERSIONS)' != ''">$([System.Text.RegularExpressions.Regex]::Match(' $(RELEASE_TRAIN_VERSIONS) ', '\s$(ReleaseTrain)=(\S+)\s').Groups[1].Value)</_ReleaseTrainVersion>
    <MinVerVersionOverride>$(_ReleaseTrainVersion)</MinVerVersionOverride>
  </PropertyGroup>

  <!--
    release-pack.sh holds each package to the API of its train's previous release (ReleaseBaselineVersions,
    "core=1.2.0 satellites=0.4.0", naming only the trains it validates), except one that nuget.org does not have at
    that version (a package added since), whose baseline would fail to restore. It passes the versions and the
    projects to leave out. They are named by project rather than by PackageId, which NuGet's pack targets only
    default later in the evaluation.
  -->
  <PropertyGroup Condition="'$(ReleaseBaselineVersions)' != '' and !$([System.String]::Copy(' $(ProjectsWithoutBaseline) ').Contains(' $(MSBuildProjectName) '))">
    <PackageValidationBaselineVersion>$([System.Text.RegularExpressions.Regex]::Match(' $(ReleaseBaselineVersions) ', '\s$(ReleaseTrain)=(\S+)\s').Groups[1].Value)</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" Condition="'$(GITHUB_ACTIONS)' == 'true'" />
  </ItemGroup>

  <!-- A package README, preferring one written for the package and falling back to the repository's. -->
  <ItemGroup Condition="Exists('README.md')">
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('README.md')">
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!--
    Release notes on nuget.org point back to GitHub. A stable package links to its own GitHub Release, which
    semantic-release creates with the tag right after the push. A preview has no release of its own, so it links
    to the changelog. The version is only known once MinVer has run, hence a target rather than a property.
  -->
  <Target Name="_SetPackageReleaseNotes" AfterTargets="MinVer">
    <PropertyGroup>
      <PackageReleaseNotes Condition="'$(MinVerPreRelease)' == ''">$(RepositoryUrl)/releases/tag/v$(PackageVersion)</PackageReleaseNotes>
      <PackageReleaseNotes Condition="'$(MinVerPreRelease)' != ''">$(RepositoryUrl)/blob/main/CHANGELOG.md</PackageReleaseNotes>
    </PropertyGroup>
  </Target>

  <!-- The unit suite's eleven projects, one per family of .github/ci-families.json
       (docs/adr/0013-run-a-targeted-pull-request-ci-and-the-heavy-jobs-before-a-release.md), and the generator and
       integration suites, not one per package: an internal member no input reaches is tested directly
       (docs/adr/0006-coverage-is-a-signal-not-a-goal.md), and only these assemblies exist to do it. -->
  <ItemGroup>
    <InternalsVisibleTo Include="AdCodicem.ValueObjects.UnitTests" />
    <InternalsVisibleTo Include="AdCodicem.ValueObjects.UnitTests.AspNet" />
    <InternalsVisibleTo Include="AdCodicem.ValueObjects.UnitTests.EfCore" />
    <InternalsVisibleTo Include="AdCodicem.ValueObjects.UnitTests.Data" />
    <InternalsVisibleTo Include="AdCodicem.ValueObjects.UnitTests.Serialization" />
    <InternalsVisibleTo Include="AdCodicem.ValueObjects.UnitTests.Orleans" />
    <InternalsVisibleTo Include="AdCodicem.ValueObjects.UnitTests.Hosts" />
    <InternalsVisibleTo Include="AdCodicem.ValueObjects.UnitTests.GraphQL" />
    <InternalsVisibleTo Include="AdCodicem.ValueObjects.UnitTests.Text" />
    <InternalsVisibleTo Include="AdCodicem.ValueObjects.UnitTests.Observability" />
    <InternalsVisibleTo Include="AdCodicem.ValueObjects.UnitTests.TestData" />
    <InternalsVisibleTo Include="AdCodicem.ValueObjects.GeneratorTests" />
    <InternalsVisibleTo Include="AdCodicem.ValueObjects.IntegrationTests" />
  </ItemGroup>
</Project>
