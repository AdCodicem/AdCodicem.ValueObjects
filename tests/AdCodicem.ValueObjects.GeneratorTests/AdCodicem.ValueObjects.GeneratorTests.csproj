<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AdCodicem.ValueObjects.GeneratorTests</RootNamespace>

    <!-- The generator targets netstandard2.0; referencing it here would drag its Roslyn version along. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <!-- The workspace a code fix edits a document in. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Basic.Reference.Assemblies.Net100" />
    <!-- Handed to every snippet, so that one classifies a value object as personal data as a consumer does. -->
    <PackageReference Include="Microsoft.Extensions.Compliance.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referenced as a library, not as an analyzer: these tests drive the generator themselves. -->
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.Generators\AdCodicem.ValueObjects.Generators.csproj" />
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.CodeFixes\AdCodicem.ValueObjects.CodeFixes.csproj" />
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.Abstractions\AdCodicem.ValueObjects.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.Identifiers\AdCodicem.ValueObjects.Identifiers.csproj" />
    <!-- Handed to a snippet only on request: the generator publishes its JSON converters when the package is there. -->
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.Json\AdCodicem.ValueObjects.Json.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AdCodicem.ValueObjects.GeneratorTests.Harness" />
    <Using Include="AdCodicem.ValueObjects.Generators.Analyzers" />
  </ItemGroup>

  <!--
    The harness runs the framework's regex source generator beside this repository's, so that a snippet can implement
    IValueObjectPatternValidator with a [GeneratedRegex] partial property, as the documentation does. The generator
    ships in the targeting pack, not in Basic.Reference.Assemblies: it is taken from the analyzers this project is
    itself compiled with, so the SDK decides the version, on a laptop and in CI alike.
  -->
  <Target Name="CopyRegexGenerator" AfterTargets="ResolveTargetingPackAssets" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_RegexGenerator Include="@(Analyzer)"
                       Condition="'%(Filename)' == 'System.Text.RegularExpressions.Generator' and $([System.String]::new('%(FullPath)').Contains('$([System.IO.Path]::DirectorySeparatorChar)cs$([System.IO.Path]::DirectorySeparatorChar)'))" />
      <None Include="@(_RegexGenerator)" Link="regex-generator\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <Error Condition="'@(_RegexGenerator)' == ''"
           Text="The targeting pack's System.Text.RegularExpressions.Generator.dll was not found among this project's analyzers." />
  </Target>

  <!--
    The System.Text.Json source generator, taken the same way, runs only for the tests that ask for it: VO0032 must stay
    silent on the code it writes for a value object, `ObjectCreator = () => new global::Sku()` among it.
  -->
  <Target Name="CopyJsonGenerator" AfterTargets="ResolveTargetingPackAssets" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_JsonGenerator Include="@(Analyzer)"
                      Condition="'%(Filename)' == 'System.Text.Json.SourceGeneration' and $([System.String]::new('%(FullPath)').Contains('$([System.IO.Path]::DirectorySeparatorChar)cs$([System.IO.Path]::DirectorySeparatorChar)'))" />
      <None Include="@(_JsonGenerator)" Link="json-generator\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <Error Condition="'@(_JsonGenerator)' == ''"
           Text="The targeting pack's System.Text.Json.SourceGeneration.dll was not found among this project's analyzers." />
  </Target>

</Project>
