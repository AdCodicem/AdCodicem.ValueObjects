<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AdCodicem.ValueObjects.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\samples\AdCodicem.ValueObjects.Sample.Api\AdCodicem.ValueObjects.Sample.Api.csproj" />
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.EntityFrameworkCore\AdCodicem.ValueObjects.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.Dapper\AdCodicem.ValueObjects.Dapper.csproj" />
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.MongoDB\AdCodicem.ValueObjects.MongoDB.csproj" />
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.Identifiers.MongoDB\AdCodicem.ValueObjects.Identifiers.MongoDB.csproj" />
    <!-- Value objects over the date and time types the sample does not use, to read what each provider returns
         for those columns (Fixtures/DateAndTimeValueObjects.cs), and the unit suite's value object for each underlying
         type, which MongoDB stores through a real server (MongoDbTests.cs). -->
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.Generators\AdCodicem.ValueObjects.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Functions application the host's container runs (Fixtures/FunctionsHostFixture.cs): built with this project,
         never loaded by it, and found by the fixture where the build writes it. -->
    <ProjectReference Include="..\Fixtures\AdCodicem.ValueObjects.Fixtures.Functions\AdCodicem.ValueObjects.Fixtures.Functions.csproj"
                      ReferenceOutputAssembly="false" />
    <AssemblyMetadata Include="FunctionsApplication" Value="$(ArtifactsPath)/bin/AdCodicem.ValueObjects.Fixtures.Functions/$(Configuration.ToLowerInvariant())" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Testcontainers.MongoDb" />
    <!-- Azurite, which the Functions host's queue triggers run on, and the client that enqueues their messages. -->
    <PackageReference Include="Testcontainers.Azurite" />
    <PackageReference Include="Azure.Storage.Queues" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Dapper" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\AdCodicem.ValueObjects.UnitTests\Domain\UnderlyingTypes.cs" Link="Fixtures\UnderlyingTypes.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AdCodicem.ValueObjects" />
    <Using Include="AdCodicem.ValueObjects.Annotations" />
    <Using Include="AdCodicem.ValueObjects.Identifiers" />
    <Using Include="AdCodicem.ValueObjects.Sample.Domain" />
    <Using Include="AdCodicem.ValueObjects.Sample.Api.Persistence" />
  </ItemGroup>

</Project>
