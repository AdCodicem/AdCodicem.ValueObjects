<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The data family's unit tests (.github/ci-families.json): AdCodicem.ValueObjects.Dapper,
    AdCodicem.ValueObjects.MongoDB and AdCodicem.ValueObjects.Identifiers.MongoDB, offline; the integration suite runs
    them against the real engines.
  -->
  <Import Project="..\UnitTests.props" />

  <ItemGroup>
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.Dapper\AdCodicem.ValueObjects.Dapper.csproj" />
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.MongoDB\AdCodicem.ValueObjects.MongoDB.csproj" />
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.Identifiers.MongoDB\AdCodicem.ValueObjects.Identifiers.MongoDB.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated value objects in an assembly that opts into XML serialization, which MongoDbStartUpTests loads into a
         context of its own. -->
    <ProjectReference Include="..\Fixtures\AdCodicem.ValueObjects.Fixtures.XmlSerialization\AdCodicem.ValueObjects.Fixtures.XmlSerialization.csproj" />
  </ItemGroup>

  <!-- The sources of other families' folders this project compiles too, at the same path, so that a resource keeps
       its name. -->
  <ItemGroup>
    <Compile Include="..\AdCodicem.ValueObjects.UnitTests\CodeCarrying.cs" Link="CodeCarrying.cs" />
    <Compile Include="..\AdCodicem.ValueObjects.UnitTests\Identifiers\DeterministicEntropy.cs" Link="Identifiers\DeterministicEntropy.cs" />
    <Compile Include="..\AdCodicem.ValueObjects.UnitTests\Persistence\NonUnicodeValueObjects.cs" Link="Persistence\NonUnicodeValueObjects.cs" />
    <Compile Include="..\AdCodicem.ValueObjects.UnitTests\WithoutDynamicCode.cs" Link="WithoutDynamicCode.cs" />
  </ItemGroup>

</Project>
