<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AdCodicem.ValueObjects.UnitTests</RootNamespace>

    <!-- Generated sources land on disk so they can be read, diffed and reviewed like any other code. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>

    <!-- Microsoft.AspNetCore.OpenApi's generator reaches this project through the OpenApi project and intercepts
         AddOpenApi; the package's build targets, which allow its interceptors, come only with a direct reference. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <!-- Under an alias too: the reader of a .NET pattern, src/Shared/ValueObjectPatternSyntax.cs, is compiled into the
         contracts and into the MongoDB package, and its tests name the contracts' copy through the alias. -->
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.Abstractions\AdCodicem.ValueObjects.Abstractions.csproj" Aliases="global,abstractions" />
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.Identifiers\AdCodicem.ValueObjects.Identifiers.csproj" />
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.Json\AdCodicem.ValueObjects.Json.csproj" />
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.Testing\AdCodicem.ValueObjects.Testing.csproj" />
    <!-- Under an alias too: src/Shared/TypeNames.cs is compiled into the sampler and into each of its library adapters,
         and its tests name the sampler's copy through the alias. -->
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.Testing.Data\AdCodicem.ValueObjects.Testing.Data.csproj" Aliases="global,testingdata" />
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.AutoFixture\AdCodicem.ValueObjects.AutoFixture.csproj" />
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.Bogus\AdCodicem.ValueObjects.Bogus.csproj" />
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.FsCheck\AdCodicem.ValueObjects.FsCheck.csproj" />
    <!-- The integrations, whose behaviour is tested here directly; the integration suite keeps what only a real
         database or a real HTTP pipeline can confirm (docs/adr/0006-coverage-is-a-signal-not-a-goal.md). -->
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.AspNetCore\AdCodicem.ValueObjects.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.AspNetCore.Http\AdCodicem.ValueObjects.AspNetCore.Http.csproj" />
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.AspNetCore.NewtonsoftJson\AdCodicem.ValueObjects.AspNetCore.NewtonsoftJson.csproj" />
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.Dapper\AdCodicem.ValueObjects.Dapper.csproj" />
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.EntityFrameworkCore\AdCodicem.ValueObjects.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.FluentValidation\AdCodicem.ValueObjects.FluentValidation.csproj" />
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.Identifiers.EntityFrameworkCore\AdCodicem.ValueObjects.Identifiers.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.Identifiers.MongoDB\AdCodicem.ValueObjects.Identifiers.MongoDB.csproj" />
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.MessagePack\AdCodicem.ValueObjects.MessagePack.csproj" />
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.MongoDB\AdCodicem.ValueObjects.MongoDB.csproj" />
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.NewtonsoftJson\AdCodicem.ValueObjects.NewtonsoftJson.csproj" />
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.OpenApi\AdCodicem.ValueObjects.OpenApi.csproj" />
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.Serilog\AdCodicem.ValueObjects.Serilog.csproj" />
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.Swashbuckle\AdCodicem.ValueObjects.Swashbuckle.csproj" />
    <ProjectReference Include="..\..\src\AdCodicem.ValueObjects.Generators\AdCodicem.ValueObjects.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Value objects this assembly cannot hold: one in a module no test has touched yet, hand-written ones
         annotated where the generator does not run, generated ones in an assembly that does not reference the JSON
         package, and generated ones in an assembly that opts into XML serialization
         (tests/Fixtures/Directory.Build.props). -->
    <ProjectReference Include="..\Fixtures\AdCodicem.ValueObjects.Fixtures.Untouched\AdCodicem.ValueObjects.Fixtures.Untouched.csproj" />
    <ProjectReference Include="..\Fixtures\AdCodicem.ValueObjects.Fixtures.WithoutGenerator\AdCodicem.ValueObjects.Fixtures.WithoutGenerator.csproj" />
    <ProjectReference Include="..\Fixtures\AdCodicem.ValueObjects.Fixtures.WithoutJson\AdCodicem.ValueObjects.Fixtures.WithoutJson.csproj" />
    <ProjectReference Include="..\Fixtures\AdCodicem.ValueObjects.Fixtures.XmlSerialization\AdCodicem.ValueObjects.Fixtures.XmlSerialization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Property-based testing, in PropertyTests.cs, and the libraries the test-data packages are driven through, in
         TestData/. Deliberately the bare FsCheck package, as the FsCheck package depends on, and not FsCheck.Xunit,
         whose xunit.extensibility.execution [2.4.1, 3.0.0) dependency conflicts with xunit.v3; the properties run from
         plain [Fact]s through Check(Config) instead. -->
    <PackageReference Include="FsCheck" />
    <PackageReference Include="AutoFixture" />
    <PackageReference Include="Bogus" />
    <!-- A JSON Schema validator, which checks that what the serializer writes is what the exported schema describes. -->
    <PackageReference Include="LateApexEarlySpeed.Json.Schema" />
    <!-- A provider, so that a DbContext can build the model the Entity Framework Core conventions shape; building it
         opens no connection. Round trips through a real engine stay in the integration suite. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- An in-memory server, so that the ASP.NET Core and OpenAPI integrations are driven by real requests without
         a socket. The sample's end-to-end flows stay in the integration suite. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <!-- The .NET client of a SignalR hub, which the MessagePack package's hub protocol helper is tested through, end to
         end, over TestHost. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <!-- DataClassificationAttribute, which a value object of Domain/ derives to be classified as personal data. -->
    <PackageReference Include="Microsoft.Extensions.Compliance.Abstractions" />
    <!-- What an application writes Serilog events with: the compact JSON formatter, Serilog.Expressions' filters and
         templates, and the Microsoft.Extensions.Logging provider, which LogInformation and [LoggerMessage] calls go
         through. -->
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Expressions" />
    <PackageReference Include="Serilog.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AdCodicem.ValueObjects" />
    <Using Include="AdCodicem.ValueObjects.Annotations" />
    <Using Include="AdCodicem.ValueObjects.UnitTests.Domain" />
  </ItemGroup>

</Project>
