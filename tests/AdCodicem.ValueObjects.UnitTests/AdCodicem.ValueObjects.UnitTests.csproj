<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The core family's unit tests (.github/ci-families.json): the generated code over the value objects of Domain/,
    the contracts, the JSON package, the identifiers, the test-data sampler, DataAnnotations and XML serialization. It
    holds the sources every project of the suite compiles: Domain/, the hub of GeneratedSurface/ and the helpers core's
    tests share with other families, which tests/UnitTests.props and each project link.
  -->
  <Import Project="..\UnitTests.props" />

  <ItemGroup>
    <!-- Value objects this assembly cannot hold: one in a module no test has touched yet, hand-written ones annotated
         where the generator does not run, generated ones in an assembly that does not reference the JSON package,
         and generated ones in an assembly that opts into XML serialization (tests/Fixtures/CLAUDE.md). -->
    <ProjectReference Include="..\Fixtures\AdCodicem.ValueObjects.Fixtures.Untouched\AdCodicem.ValueObjects.Fixtures.Untouched.csproj" />
    <ProjectReference Include="..\Fixtures\AdCodicem.ValueObjects.Fixtures.WithoutGenerator\AdCodicem.ValueObjects.Fixtures.WithoutGenerator.csproj" />
    <ProjectReference Include="..\Fixtures\AdCodicem.ValueObjects.Fixtures.WithoutJson\AdCodicem.ValueObjects.Fixtures.WithoutJson.csproj" />
    <ProjectReference Include="..\Fixtures\AdCodicem.ValueObjects.Fixtures.XmlSerialization\AdCodicem.ValueObjects.Fixtures.XmlSerialization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- What ASP.NET Core's shared framework holds of core's tests: BadHttpRequestException, whose code
         ErrorCodeCarrierTests reads, and the generic host and configuration DataAnnotationsHostTests and
         AnyEntityIdTests bind options through. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The properties of ErrorCodeCarrierTests, from plain [Fact]s through Check(Config). -->
    <PackageReference Include="FsCheck" />
    <!-- A JSON Schema validator, which checks that what the serializer writes is what the exported schema describes. -->
    <PackageReference Include="LateApexEarlySpeed.Json.Schema" />
    <!-- ObservableValidator, the view model base of CommunityToolkit.Mvvm, which validates the DataAnnotations attributes
         of a property as it is set and keeps the results it reports; DataAnnotations/ runs [ParsesAs] and [NotDefault]
         through it. -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

</Project>
