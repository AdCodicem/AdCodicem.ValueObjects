<Project>

  <!--
    The compatibility island: the packages exactly as nuget.org would serve them, installed into an application on the
    next .NET major. Deliberately no import of the repository's Directory.Build.props, whose settings describe the
    code that is packed (net10.0, trimming and AOT analysers, the artifacts folder, the package metadata), not an
    application that consumes it. This folder has its own global.json, nuget.config and Directory.Packages.props for
    the same reason, and is in no solution: the root build and the suites never see it, ci.yml's whitespace check does.
  -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      What xunit.v3's props set anyway, said here so that it holds without them. The project an older SDK sees is empty
      and imports none, and `dotnet test` would call it a VSTest project before the build could give the reason; a
      restore that SDK left in obj/ would then mislead the next run on the right one.
    -->
    <IsTestingPlatformApplication>true</IsTestingPlatformApplication>
    <OutputType>Exe</OutputType>
    <!-- CA1707: underscores make test names readable as sentences, as in the suites. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <!--
    The packages under test are whatever artifacts/packages holds, each at the version in its file name
    (Directory.Packages.props): pack them there first. A restore that finds none stops here with the reason, rather
    than on a missing version for every package.
  -->
  <Target Name="_RequirePackedPackages" BeforeTargets="_GenerateRestoreProjectSpec;CollectPackageReferences" Condition="'@(_PackedPackage)' == '' and '$(CompatSdkMissing)' != 'true'">
    <Error Text="artifacts/packages holds no AdCodicem.ValueObjects package: pack them there first, dotnet pack src/AdCodicem.ValueObjects.Packages.slnf -c Release -o artifacts/packages, from the repository's root." />
  </Target>

</Project>
