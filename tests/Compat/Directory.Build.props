<Project>

  <!--
    The compatibility island: the packages exactly as nuget.org would serve them, installed into an application on the
    next .NET major. Deliberately no import of the repository's Directory.Build.props, whose settings describe the
    code that is packed (net10.0, trimming and AOT analysers, the artifacts folder, the package metadata), not an
    application that consumes it. This folder has its own global.json, nuget.config and Directory.Packages.props for
    the same reason, and is in no solution: the root build, `dotnet format` and the suites never see it.
  -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      What xunit.v3's props set anyway, said here so that it holds without them. The project an older SDK sees is empty
      and imports none, and `dotnet test` would call it a VSTest project before the build could give the reason; a
      restore that SDK left in obj/ would then mislead the next run on the right one.
    -->
    <IsTestingPlatformApplication>true</IsTestingPlatformApplication>
    <OutputType>Exe</OutputType>
    <!-- CA1707: underscores make test names readable as sentences, as in the suites. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <!--
    The version of the packages under test, read by the caller off the file names of the packages it just packed and
    passed as -p:AdCodicemVersion=<version>. Never a floating range: Directory.Packages.props asks for exactly this
    version, so a stale or missing package fails the restore instead of being replaced by another.
  -->
  <Target Name="_RequireAdCodicemVersion" BeforeTargets="_GenerateRestoreProjectSpec;CollectPackageReferences" Condition="'$(AdCodicemVersion)' == '' and '$(CompatSdkMissing)' != 'true'">
    <Error Text="AdCodicemVersion is not set. Pass the version of the packages in artifacts/packages, read off their file names: -p:AdCodicemVersion=&lt;version&gt;." />
  </Target>

</Project>
