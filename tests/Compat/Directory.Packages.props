<Project>

  <!--
    Versions for the island only; the repository's Directory.Packages.props, which pins what the packages are built
    against, is deliberately not imported. No transitive pinning either: the graph is the one an application without
    central package management gets, where the dependency floors of the packages under test meet the next major.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Without a version, "[]" would fail even the restore of the empty project an older SDK sees (the project file
       says why); Directory.Build.props stops a real restore that lacks one with the reason instead. -->
  <ItemGroup Label="Under test, at exactly the version just packed" Condition="'$(AdCodicemVersion)' != ''">
    <PackageVersion Include="AdCodicem.ValueObjects" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.Abstractions" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.AI" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.AspNetCore" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.AspNetCore.Http" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.AspNetCore.NewtonsoftJson" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.AutoFixture" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.AzureFunctions" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.AzureFunctions.AspNetCore" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.Blazor" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.Bogus" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.CommandLine" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.CsvHelper" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.Dapper" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.EntityFrameworkCore" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.FluentValidation" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.FsCheck" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.Grpc" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.HotChocolate" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.HotChocolate.Data" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.Identifiers" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.Identifiers.EntityFrameworkCore" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.Identifiers.MongoDB" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.Json" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.Marten" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.MessagePack" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.ModelContextProtocol" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.MongoDB" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.NewtonsoftJson" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.NJsonSchema" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.OpenApi" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.Orleans" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.ProtobufNet" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.Serilog" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.Swashbuckle" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.Testing" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.Testing.Data" Version="[$(AdCodicemVersion)]" />
    <PackageVersion Include="AdCodicem.ValueObjects.Wolverine.Http" Version="[$(AdCodicemVersion)]" />
  </ItemGroup>

  <!--
    The next major, as an application on it references it. Npgsql's provider pins Entity Framework Core to the exact
    build it was compiled against, so the providers move together, release candidate by release candidate: Entity
    Framework Core's two stay on RC1 until Npgsql publishes its RC2, while the ASP.NET Core packages are on RC2, whose
    SignalR packages fix GHSA-86xp-94pg-8r6r and GHSA-334f-vvp4-7g6p.
  -->
  <ItemGroup Label=".NET 11">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-rc.1.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="11.0.0-rc.2.26504.105" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0-rc.2.26504.105" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0-rc.2.26504.105" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="11.0.0-rc.2.26504.105" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0-rc.2.26504.105" />
    <!-- System.CommandLine's next major, whose version carries .NET's build number: it moves with each release candidate,
         and to 3.0.0 when .NET 11 ships. -->
    <PackageVersion Include="System.CommandLine" Version="3.0.0-rc.2.26504.105" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.1" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.MongoDb" Version="4.15.0" />
    <!-- The libraries the test-data packages adapt, at the floors the packages declare. -->
    <PackageVersion Include="AutoFixture" Version="4.18.1" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="FsCheck" Version="3.4.0" />
    <!-- Microsoft.Extensions.AI ships one line for every runtime, the next major's included: an application on it
         references 10.x, whose abstractions resolve at the AI package's floor. -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <!-- NSwag's document generation and Confluent's JSON serdes for the Schema Registry, which the NJsonSchema package
         plugs into, at their current stables; the Kafka client's native library comes with the serdes, which never
         load it, and is referenced only to leave it out of the output. -->
    <PackageVersion Include="NSwag.AspNetCore" Version="14.7.1" />
    <PackageVersion Include="Confluent.SchemaRegistry.Serdes.Json" Version="2.16.0" />
    <PackageVersion Include="librdkafka.redist" Version="2.16.0" />
    <!-- The gRPC servers and client the protobuf-net and gRPC packages plug into, at their current stables: one line for
         every runtime, the next major's included. -->
    <PackageVersion Include="protobuf-net.Grpc.AspNetCore" Version="1.3.14" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.84.0" />
    <!-- Wolverine's dynamic mode, which compiles the endpoints' generated code with Roslyn at run time, at the version of
         the WolverineFx.Http the Wolverine.Http package brings at its floor: one line for every runtime, the next major's
         included. -->
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.51.0" />
  </ItemGroup>

</Project>
