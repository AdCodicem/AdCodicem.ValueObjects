<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Grains, grain interfaces, [GenerateSerializer] holders and value objects of their own, which Orleans' code generator
    writes proxies, invokers and codecs for, as it does for an application's grain interfaces. It does not reference the
    Orleans package: an application's grains are declared without it, and the composition root of every silo and client
    calls AddValueObjects(). The unit suite gets Orleans' generator anyway, through Microsoft.Orleans.TestingHost, and its
    output lists this assembly as an application part, which is how a test cluster finds these grains.
  -->
  <PropertyGroup>
    <RootNamespace>AdCodicem.ValueObjects.Fixtures.Grains</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\AdCodicem.ValueObjects.Abstractions\AdCodicem.ValueObjects.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\src\AdCodicem.ValueObjects.Generators\AdCodicem.ValueObjects.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Sdk" PrivateAssets="all" />
  </ItemGroup>

</Project>
