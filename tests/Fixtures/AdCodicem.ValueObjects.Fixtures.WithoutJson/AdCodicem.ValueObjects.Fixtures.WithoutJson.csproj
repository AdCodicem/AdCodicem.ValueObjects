<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Value objects generated into an assembly that references the contracts and the generator, not AdCodicem.ValueObjects.Json,
    as a domain project does when only the API project declares the serializer context: their converters reach the
    context through the descriptors the generator registers.
  -->
  <PropertyGroup>
    <RootNamespace>AdCodicem.ValueObjects.Fixtures.WithoutJson</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\AdCodicem.ValueObjects.Abstractions\AdCodicem.ValueObjects.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\src\AdCodicem.ValueObjects.Generators\AdCodicem.ValueObjects.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
