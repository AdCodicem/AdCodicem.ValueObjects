<Project Sdk="Microsoft.NET.Sdk">

  <!--
    An application published with native AOT by ci.yml's native AOT (Marten) job, apart from the main application: a
    Marten document store over PostgreSQL, which the job starts as a service container and names in NATIVE_AOT_POSTGRES.
    The script runs it once under the JIT and once as the native binary, each in the same schema, cleared first, and
    fails when the two outputs differ, as for the main application.

    It is an application of its own because Marten's publish warns for Marten, JasperFx, Weasel and FastExpressionCompiler
    themselves: the script lets through the warnings aot-warnings.allowed lists, which never name this library, and fails
    on any other, which the main application would not let it tell apart; and because it needs a server.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AdCodicem.ValueObjects.NativeAot.Documents</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Set as a property of this project, not as -p:PublishAot, which would reach the netstandard2.0 generator too. -->
    <PublishAot Condition="'$(NativeAot)' == 'true'">true</PublishAot>

    <!-- PublishAot turns these on and dynamic code off, so the JIT run does the same: the store serializes through the
         source-generated context alone, and the member source refuses a value object nothing registered, as natively. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <DynamicCodeSupport>false</DynamicCodeSupport>
  </PropertyGroup>

  <!-- So that the AOT compiler finishes the publish, and the script, rather than TreatWarningsAsErrors, judges Marten's own
       warnings against aot-warnings.allowed. -->
  <PropertyGroup Condition="'$(NativeAot)' == 'true'">
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2026;IL2104;IL3053</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\AdCodicem.ValueObjects.Marten\AdCodicem.ValueObjects.Marten.csproj" />
    <ProjectReference Include="..\AdCodicem.ValueObjects.NativeAot.Domain\AdCodicem.ValueObjects.NativeAot.Domain.csproj" />
    <ProjectReference Include="..\..\..\src\AdCodicem.ValueObjects.Generators\AdCodicem.ValueObjects.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\AdCodicem.ValueObjects.NativeAot\Report.cs" Link="Report.cs" />
    <Compile Include="..\..\AdCodicem.ValueObjects.UnitTests\Domain\HandWritten\HandWrittenCode.cs" Link="UnitTests\HandWrittenCode.cs" />
    <Compile Include="..\..\AdCodicem.ValueObjects.UnitTests\Domain\HandWritten\UnregisteredCode.cs" Link="UnitTests\UnregisteredCode.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AdCodicem.ValueObjects" />
    <Using Include="AdCodicem.ValueObjects.Annotations" />
    <Using Include="AdCodicem.ValueObjects.NativeAot.Domain" />
    <Using Include="AdCodicem.ValueObjects.UnitTests.Domain" />
    <Using Include="AdCodicem.ValueObjects.UnitTests.Domain.HandWritten" />
  </ItemGroup>

</Project>
