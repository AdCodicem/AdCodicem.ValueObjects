<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    An application published with native AOT by ci.yml's native AOT job, which runs it once under the JIT and once as
    the native binary and fails when the two outputs differ (Program.cs). It references every package that claims to
    be AOT-compatible, and its value objects come from a domain project, where the Request Delegate Generator sees their
    interfaces; the RDG suite covers those declared in the endpoints' project. Microsoft.Extensions.AI builds the tools
    of LanguageModels.cs from their methods at run time, over the source-generated context, and so does the Model Context
    Protocol SDK for the server of Mcp.cs, in process over a pair of pipes. Two value objects written by
    hand, linked from the unit suite, have no generated converter: Program.cs registers them without one, so the JSON
    factory serves them its general-purpose converter. A third, UnregisteredCode, is registered by nothing, and the
    factory refuses it.
  -->
  <PropertyGroup>
    <RootNamespace>AdCodicem.ValueObjects.NativeAot</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Set as a property of this project, not as -p:PublishAot, which would reach the netstandard2.0 generator too. -->
    <PublishAot Condition="'$(NativeAot)' == 'true'">true</PublishAot>

    <!-- PublishAot turns the first two on and dynamic code off, so the JIT run does the same: it binds through the code
         the Request Delegate Generator writes, serializes through the source-generated context alone, and takes the
         branch code guarded by RuntimeFeature.IsDynamicCodeSupported takes, as the native binary does. Its output would
         otherwise differ where native AOT changes nothing in what runs: the reflection-based binding refuses empty text
         the RDG binds as null, a type missing from the context would serialize by reflection, and the JSON factory
         would describe by reflection the value object nothing registered, which it refuses without dynamic code. The
         switch stops no reflection under the JIT: a MakeGenericType or a MakeGenericMethod left unguarded still runs
         there, and still fails the native binary. -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <DynamicCodeSupport>false</DynamicCodeSupport>
  </PropertyGroup>

  <!-- Serilog's build targets turn object destructuring off under PublishTrimmed, which PublishAot implies, so the JIT run
       does the same: an object logged with @ is the text its ToString() writes in both runs. Conditioned so that the
       native publish keeps Serilog's own item alone. -->
  <ItemGroup Condition="'$(PublishTrimmed)' != 'true'">
    <RuntimeHostConfigurationOption Include="Serilog.Capturing.IsStructureValueSupported" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\AdCodicem.ValueObjects.Abstractions\AdCodicem.ValueObjects.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\src\AdCodicem.ValueObjects.AI\AdCodicem.ValueObjects.AI.csproj" />
    <ProjectReference Include="..\..\..\src\AdCodicem.ValueObjects.AspNetCore.Http\AdCodicem.ValueObjects.AspNetCore.Http.csproj" />
    <ProjectReference Include="..\..\..\src\AdCodicem.ValueObjects.Identifiers\AdCodicem.ValueObjects.Identifiers.csproj" />
    <ProjectReference Include="..\..\..\src\AdCodicem.ValueObjects.Json\AdCodicem.ValueObjects.Json.csproj" />
    <ProjectReference Include="..\..\..\src\AdCodicem.ValueObjects.FluentValidation\AdCodicem.ValueObjects.FluentValidation.csproj" />
    <ProjectReference Include="..\..\..\src\AdCodicem.ValueObjects.ModelContextProtocol\AdCodicem.ValueObjects.ModelContextProtocol.csproj" />
    <ProjectReference Include="..\..\..\src\AdCodicem.ValueObjects.Serilog\AdCodicem.ValueObjects.Serilog.csproj" />
    <ProjectReference Include="..\AdCodicem.ValueObjects.NativeAot.Domain\AdCodicem.ValueObjects.NativeAot.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\AdCodicem.ValueObjects.UnitTests\Domain\HandWritten\HandWrittenCode.cs" Link="UnitTests\HandWrittenCode.cs" />
    <Compile Include="..\..\AdCodicem.ValueObjects.UnitTests\Domain\HandWritten\HandWrittenLink.cs" Link="UnitTests\HandWrittenLink.cs" />
    <Compile Include="..\..\AdCodicem.ValueObjects.UnitTests\Domain\HandWritten\UnregisteredCode.cs" Link="UnitTests\UnregisteredCode.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AdCodicem.ValueObjects" />
    <Using Include="AdCodicem.ValueObjects.Identifiers" />
    <Using Include="AdCodicem.ValueObjects.NativeAot.Domain" />
    <Using Include="AdCodicem.ValueObjects.UnitTests.Domain" />
    <Using Include="AdCodicem.ValueObjects.UnitTests.Domain.HandWritten" />
  </ItemGroup>

</Project>
