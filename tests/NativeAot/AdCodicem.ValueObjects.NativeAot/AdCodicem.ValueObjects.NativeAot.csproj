<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    An application published with native AOT by ci.yml's native AOT job, which runs it once under the JIT and once as
    the native binary and fails when the two outputs differ (Program.cs). It references every package that claims to
    be AOT-compatible, and its value objects come from a domain project, where the Request Delegate Generator sees their
    interfaces; the RDG suite covers those declared in the endpoints' project.
  -->
  <PropertyGroup>
    <RootNamespace>AdCodicem.ValueObjects.NativeAot</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Set as a property of this project, not as -p:PublishAot, which would reach the netstandard2.0 generator too. -->
    <PublishAot Condition="'$(NativeAot)' == 'true'">true</PublishAot>

    <!-- PublishAot turns both on, so the JIT run turns them on as well: it binds through the code the Request Delegate
         Generator writes and serializes through the source-generated context alone, as the native binary does. Its
         output would otherwise differ for reasons that are not this library's: the reflection-based binding refuses
         empty text the RDG binds as null, and a type missing from the context would serialize by reflection. -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\AdCodicem.ValueObjects.Abstractions\AdCodicem.ValueObjects.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\src\AdCodicem.ValueObjects.Identifiers\AdCodicem.ValueObjects.Identifiers.csproj" />
    <ProjectReference Include="..\..\..\src\AdCodicem.ValueObjects.Json\AdCodicem.ValueObjects.Json.csproj" />
    <ProjectReference Include="..\..\..\src\AdCodicem.ValueObjects.FluentValidation\AdCodicem.ValueObjects.FluentValidation.csproj" />
    <ProjectReference Include="..\AdCodicem.ValueObjects.NativeAot.Domain\AdCodicem.ValueObjects.NativeAot.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AdCodicem.ValueObjects" />
    <Using Include="AdCodicem.ValueObjects.Identifiers" />
    <Using Include="AdCodicem.ValueObjects.NativeAot.Domain" />
    <Using Include="AdCodicem.ValueObjects.UnitTests.Domain" />
  </ItemGroup>

</Project>
