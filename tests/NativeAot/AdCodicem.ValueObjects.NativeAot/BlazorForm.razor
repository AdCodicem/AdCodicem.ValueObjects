@typeparam TValue

@* A form of one field bound to a value object, or to its nullable type, whose input Forms.cs types text into. *@
<EditForm EditContext="Context">
    <TypedInput id="@Id" @bind-Value="Model.Value" Ready="Ready" SchemaAttributes="true" />
    <ValidationMessage For="() => Model.Value" />
</EditForm>

@code {
    /// <summary>Gets or sets the id of the input.</summary>
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    /// <summary>Gets or sets what is handed the input once it is initialized.</summary>
    [Parameter, EditorRequired]
    public Action<ITypedInput> Ready { get; set; } = default!;

    /// <summary>Gets the model.</summary>
    public FormModel<TValue> Model { get; } = new();

    /// <summary>Gets the form's edit context.</summary>
    public EditContext Context { get; private set; } = default!;

    /// <inheritdoc />
    protected override void OnInitialized() => Context = new EditContext(Model);
}
